# =====================================================================
#  CaiShen / 财神菜谱实验室 —— Git 忽略规则
#  安全原则：任何真实密钥、用户数据、本机依赖与中间产物都不入库
# =====================================================================

# ---- 真实密钥 / 本地私密配置（绝不可提交）--------------------------------
# ai-keys.bat 由 start-all.bat 读取并注入环境变量，只保留在本机。
# 团队协作请分发 ai-keys.example.bat（空值模板），各自填写自己的 Key。
ai-keys.bat
.env
.env.*
!.env.example
*.pem
*.key
*_token.txt
_token.txt
_t.txt

# ---- 用户上传的图片 / 运行时数据 -----------------------------------------
backend/uploads/
uploads/

# ---- 依赖 ----------------------------------------------------------------
node_modules/
**/node_modules/

# ---- 构建产物 ------------------------------------------------------------
front/dist/
admin-web/dist/
**/.vite/
backend/target/*
# 例外：保留可直接运行的后端 jar，clone 后无需 Maven 即可执行 start-all.bat。
# 若希望纯源码仓库，删除下面这一行并执行
#   git rm --cached backend/target/foodlab-1.0.0.jar
!backend/target/foodlab-1.0.0.jar

# ---- IDE / 操作系统 ------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- 日志 / 临时 / 备份 --------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.jar.original
